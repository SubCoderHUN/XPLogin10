 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "XPLogin10 Setup"
            VALUE "FileVersion",     "1.0.0.0"
            VALUE "InternalName",    "XPLogin10-Setup"
            VALUE "OriginalFilename","XPLogin10-Setup.exe"
            VALUE "ProductName",     "XPLogin10"
            VALUE "ProductVersion",  "1.0.0.0"
            VALUE "Comments",        "Installs the Windows XP style logon screen. Not affiliated with Microsoft."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

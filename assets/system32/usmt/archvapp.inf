%windir%\WS_FTP.EXT
%WsFTPLE5InstPath%\WS_FTP.INI, %WsFTPLE5InstPath%


[MSN Zone 6.Environment]
ZonePath = Registry, %HklmWowSoftware%\Microsoft\Internet Gaming Zone\Setup [Path]

[MSN Zone 6.Detect]
File, %ZonePath%\zone.exe, VERSION("ProductVersion","6.*")

[MSN Zone 6.Instructions]

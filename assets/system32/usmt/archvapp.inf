[Version]
Signature=$Windows NT$
DriverVer=07/01/2001,5.1.2535.0


[Applications]
Adobe Photoshop Suite 6, %photoshop6%
AIM, %AIM%
BattleCom, %battlecom%
CuteFTP 4, %cuteftp4%
GameVoice 1, %gamevoice%
GetRight 4, %GetRight4%
ICQ, %ICQ%
GoZilla, %GoZilla%
MSN Explorer 10, %msnexp10%
MSN Zone 6, %msnzone6%
MS Netmeeting 3, %Netmeeting3%
MS Messenger 36, %msmsgr36%
MS Money 2001, %msmoney2001%
MS Movie Maker 1, %msmvm1%
Microsoft Works 2001, %Works_Suite_2001%
Odigo, %Odigo%
Prodigy Internet, %Prodigy%
Quicken 2001, %Quicken2001%
RealJukebox 2 Basic, %RealJukebox2%
RogerWilco, %RogerWilco%
Sonique, %Sonique%
WinAmp, %WinAmp%
WordPerfect Office 2000, %WordPerfectOffice_2000%
WsFTPLE5, %WsFTPLE5%




[Adobe Photoshop Suite 6.Environment]
PhotoshopSuite6Path = Registry, %HklmWowSoftware%\Adobe\Photoshop\6.0\ApplicationPath []

[Adobe Photoshop Suite 6.Detect.1]
Registry, HKR\Software\Adobe\Photoshop\6.0, EXISTS
File, %PhotoshopSuite6Path%\Photoshp.exe, VERSION("ProductVersion","6.*")

[Adobe Photoshop Suite 6.Detect.2]
Registry, HKR\Software\Adobe\ImageReady 3.0, EXISTS
File, %PhotoshopSuite6Path%\ImageReady.exe, VERSION("ProductVersion","* 3.*")

[Adobe Photoshop Suite 6.Instructions]
ProcessSection = Adobe Photoshop 6
ProcessSection = Adobe ImageReady 3

[Adobe Photoshop 6.Environment]
Photoshop6PersonalSettings = Registry, HKR\Software\Adobe\Photoshop\6.0 [SettingsFilePath]
Photoshop6CommonColor = Directory, %CommonProgramFiles%\Adobe\Color

[Adobe Photoshop 6.Detect]
Registry, HKR\Software\Adobe\ImageReady 3.0, EXISTS
File, %PhotoshopSuite6Path%\Photoshp.exe, VERSION("ProductVersion","6.*")

[Adobe Photoshop 6.Instructions]
AddReg = Adobe Photoshop 6.AddReg
DelReg = Adobe Photoshop 6.DelReg
DestDelReg = Adobe Photoshop 6.DestDelReg
ForceSrcFile = Adobe Photoshop 6.ForceSrcFile
CopyFiles = Adobe Photoshop 6.CopyFiles
DelFiles = Adobe Photoshop 6.DelFiles

[Adobe Photoshop 6.AddReg]
HKR\Software\Adobe\Photoshop\6.0
HKR\Software\Adobe\Photoshop6\6.0\Registration

[Adobe Photoshop 6.DelReg]
HKR\Software\Adobe\Photoshop\6.0 [AppWindowPosition]
HKR\Software\Adobe\Photoshop\6.0 [PlugInDirectory]

[Adobe Photoshop 6.DestDelReg]
HKR\Software\Adobe\Photoshop\6.0 [AppWindowMaximized]
HKR\Software\Adobe\Photoshop\6.0 [MemoryUsage]
HKR\Software\Adobe\Photoshop\6.0 [ShowStatusWindow]

[Adobe Photoshop 6.ForceSrcFile]
Dir = %Photoshop6CommonColor%\Profiles\*
Dir = %Photoshop6CommonColor%\Proofing\*
Dir = %Photoshop6CommonColor%\Settings\*
Dir = %Photoshop6PersonalSettings%\*
Dir = %PhotoshopSuite6Path%\Presets\*

[Adobe Photoshop 6.CopyFiles]
Dir = %Photoshop6CommonColor%\Profiles\*
Dir = %Photoshop6CommonColor%\Proofing\*
Dir = %Photoshop6CommonColor%\Settings\*
Dir = %Photoshop6PersonalSettings%\*
Dir = %PhotoshopSuite6Path%\Presets\*

